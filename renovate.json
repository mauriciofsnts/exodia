{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["security:only-security-updates"],
  "internalChecksFilter": "strict",
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": "1 day",
    "groupName": "security updates",
    "groupSlug": "security-updates",
    "prConcurrentLimit": 1,
    "labels": ["security"]
  }
}
